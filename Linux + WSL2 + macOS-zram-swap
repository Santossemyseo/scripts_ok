#!/usr/bin/env bash
set -euo pipefail
umask 022

SCRIPT_NAME="auto-mem-tune"
ACTION="apply"
YES=0
ZRAM_PERCENT_OVERRIDE=""
SWAP_PERCENT_OVERRIDE=""
ZRAM_ALGO_FORCE_OVERRIDE=""

if [[ "${EUID:-$(id -u)}" -eq 0 && -w /var/log ]]; then
  LOG_DEFAULT="/var/log/${SCRIPT_NAME}.log"
else
  LOG_DEFAULT="${HOME:-/tmp}/${SCRIPT_NAME}.log"
fi

LOG="${LOG:-$LOG_DEFAULT}"
mkdir -p "$(dirname "$LOG")"
exec > >(tee -a "$LOG") 2>&1

TS="$(date +%Y%m%d-%H%M%S)"
BACKUP_DIR="${BACKUP_DIR:-${HOME:-/tmp}/.${SCRIPT_NAME}-backups}"

BOOT_HELPER="/usr/local/sbin/${SCRIPT_NAME}-zram.sh"
BOOT_UNIT="/etc/systemd/system/${SCRIPT_NAME}-zram.service"
SYSCTL_FILE="/etc/sysctl.d/99-${SCRIPT_NAME}.conf"
CONFIG_FILE="/etc/default/zram-tune"
SWAPFILE="/swapfile"

log(){ printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
ok(){ log "[OK] $*"; }
info(){ log "[INFO] $*"; }
warn(){ log "[WARN] $*"; }
die(){ log "[FAIL] $*"; exit 1; }

require_root() {
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    die "Ejecuta como root/sudo para esta acción."
  fi
}

is_linux() { [[ "$(uname -s)" == "Linux" ]]; }
is_wsl() { grep -qi microsoft /proc/version 2>/dev/null || uname -r | grep -qi microsoft; }

in_container() {
  [[ -f /.dockerenv ]] && return 0
  grep -qaE '(docker|containerd|kubepods|podman)' /proc/1/cgroup 2>/dev/null && return 0
  return 1
}

ensure_zram_module() {

  if modprobe zram 2>/dev/null; then
    ok "Módulo zram cargado"
    return 0
  fi

  warn "Intentando instalar soporte kernel zram..."

  if command -v apt-get >/dev/null 2>&1; then
    apt-get update -qq
    apt-get install -y linux-modules-extra-$(uname -r) || true
  fi

  modprobe zram 2>/dev/null || die "El kernel no soporta zram"
}

write_linux_config() {

cat >"$CONFIG_FILE" <<EOF
ZRAM_PERCENT=50
SWAP_PERCENT=100
ZRAM_ALGO_FORCE=
EOF

chmod 0644 "$CONFIG_FILE"

ok "Config persistente creada"
}

write_helper() {

cat >"$BOOT_HELPER" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="/etc/default/zram-tune"

[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

RAM_MB=$(free -m | awk '/Mem:/ {print $2}')

ZRAM_PERCENT="${ZRAM_PERCENT:-50}"
ZRAM_MB=$((RAM_MB * ZRAM_PERCENT / 100))

[[ "$ZRAM_MB" -lt 256 ]] && ZRAM_MB=256

if swapon --show | grep -q zram; then
echo "zram ya activo — no se recrea"
exit 0
fi

modprobe zram

DEV=$(zramctl -f --size ${ZRAM_MB}M)

mkswap "$DEV"
swapon -p 100 "$DEV"

echo "zram activo en $DEV"
EOF

chmod 0755 "$BOOT_HELPER"

ok "Helper creado"
}

write_unit() {

cat >"$BOOT_UNIT" <<EOF
[Unit]
Description=Auto memory tune zram setup
After=multi-user.target

[Service]
Type=oneshot
ExecStart=$BOOT_HELPER

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable auto-mem-tune-zram.service

ok "Servicio systemd instalado"
}

configure_swap() {

RAM=$(free -m | awk '/Mem:/ {print $2}')
SWAP=$RAM

if [[ ! -f "$SWAPFILE" ]]; then
fallocate -l ${SWAP}M "$SWAPFILE"
chmod 600 "$SWAPFILE"
mkswap "$SWAPFILE"
fi

swapon -p 10 "$SWAPFILE"

grep -q swapfile /etc/fstab || \
echo "/swapfile none swap sw 0 0" >> /etc/fstab

ok "Swapfile configurado"
}

configure_linux() {

require_root

if in_container; then
die "Ejecutar en host, no contenedor"
fi

ensure_zram_module

write_linux_config
write_helper
write_unit

"$BOOT_HELPER"

configure_swap

cat >/etc/sysctl.d/99-auto-mem-tune.conf <<EOF
vm.swappiness=10
vm.vfs_cache_pressure=50
vm.dirty_ratio=10
vm.dirty_background_ratio=5
EOF

sysctl --system >/dev/null

echo
echo "===== RESUMEN FINAL ====="
swapon --show
zramctl
free -h
echo "Configuración finalizada correctamente"
}

main() {

if is_linux; then
configure_linux
else
die "Sistema no soportado"
fi

echo
echo "[OK] Script ejecutado correctamente"
}

main "$@"
