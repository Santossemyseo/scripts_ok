// Mantiene visible/activa una sesión de Google Colab alternando el panel de conexión cada 10 minutos.
(function keepColabOpen() {
  'use strict';

  function clickConnect() {
    const iconElement = document.getElementById('toggle-header-button');
    if (!iconElement) {
      console.warn('[noclosedcolab] No se encontró #toggle-header-button.');
      return;
    }

    iconElement.dispatchEvent(new MouseEvent('click', {
      bubbles: true,
      cancelable: true,
      view: window,
    }));
  }

  clickConnect();
  window.setInterval(clickConnect, 600000);
}());
