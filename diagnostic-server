#!/usr/bin/env bash
# Genera un diagnóstico de servidor Linux: hardware, memoria, servicios, red, suspensión y telemetría.
set -u -o pipefail

section() { printf '\n===== %s =====\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }
run() { "$@" 2>/dev/null || true; }
run_grep() { local pattern="$1"; shift; "$@" 2>/dev/null | grep -E "$pattern" || true; }

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "Este diagnóstico está diseñado para Linux. Sistema detectado: $(uname -s)."
  exit 1
fi

section "INFO SISTEMA"
run hostnamectl

section "KERNEL"
uname -a

section "CPU"
if have lscpu; then
  run_grep 'Model name|Nombre del modelo|CPU\(s\)' lscpu
else
  run_grep 'model name|processor' cat /proc/cpuinfo
fi

section "RAM"
run free -h

section "DISCOS"
run lsblk

section "BIOS"
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "Ejecuta con sudo para ver BIOS vía dmidecode."
elif have dmidecode; then
  run_grep 'Vendor|Version|Release Date' dmidecode -t bios
else
  echo "dmidecode no está instalado."
fi

section "TARGET ACTIVO"
run systemctl get-default

section "DISPLAY MANAGER"
run systemctl status display-manager --no-pager | head -n 8

section "GDM"
run systemctl status gdm --no-pager | head -n 8

section "LOGIND CONFIG"
if [[ -f /etc/systemd/logind.conf ]]; then
  grep -v '^#' /etc/systemd/logind.conf | sed '/^$/d' || true
fi

section "TARGETS SUSPEND"
run systemctl status sleep.target suspend.target hibernate.target hybrid-sleep.target --no-pager

section "POWER PROFILES"
run systemctl status power-profiles-daemon --no-pager | head -n 8

section "ACPI"
run systemctl status acpid --no-pager | head -n 8

section "TIMERS SOSPECHOSOS"
run systemctl list-timers --all --no-pager | grep -Ei 'sleep|suspend|power|idle' || true

section "SERVICIOS RUNNING"
run systemctl list-units --type=service --state=running --no-pager | head -n 30

section "NETWORK"
if have nmcli; then
  run nmcli dev status
else
  echo "nmcli no está instalado; usando ip link."
  run ip -brief link
fi

section "IP"
run ip -brief address

section "TAILSCALE"
if have tailscale; then
  run tailscale status
else
  echo "tailscale no está instalado."
fi

section "TELEMETRÍA UBUNTU"
if have dpkg; then
  dpkg -l 2>/dev/null | grep -E 'whoopsie|apport|ubuntu-report|popularity-contest' || true
else
  echo "dpkg no está disponible."
fi

section "SNAP"
have snap && command -v snap || echo "snap no está instalado."

section "FLATPAK"
have flatpak && command -v flatpak || echo "flatpak no está instalado."

section "BLUETOOTH"
run systemctl status bluetooth --no-pager | head -n 8

section "CUPS"
run systemctl status cups --no-pager | head -n 8

section "AVAHI"
run systemctl status avahi-daemon --no-pager | head -n 8

section "ÚLTIMOS EVENTOS SUSPEND"
run journalctl -n 80 --no-pager | grep -Ei 'suspend|sleep|hibernate|gdm' || true
